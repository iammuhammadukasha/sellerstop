# Supabase (required for saving cash offer form data)
# Get these from: https://supabase.com/dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (optional – you get an email when someone submits the form)
# Get API key from: https://resend.com → Sign up → API Keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Where to receive the notification (e.g. your business email)
CASH_OFFER_NOTIFY_EMAIL=iammuhammadukasha@gmail.com
# Optional: use your own domain after verifying it in Resend (e.g. notifications@yourdomain.com)
# RESEND_FROM_EMAIL=Seller Stop <notifications@yourdomain.com>
